# Frontend Environment Variables
# Copy this to .env.local for local development

# Required: Backend API URL (must be set in production)
VITE_API_URL=https://api.socialraven.online

# Optional: Frontend URL (for OAuth redirects)
VITE_APP_URL=https://socialraven.online

# Optional: Sentry DSN for error tracking
# VITE_SENTRY_DSN=

# Optional: Analytics
# VITE_GA_ID=